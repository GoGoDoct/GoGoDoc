# GoGoDoc 환경 변수 템플릿 - cp .env.example .env 후 실제 값 채우기
# .env 는 커밋 금지(gitignore) - 이 파일이 팀 공유 기준. 키 누락 시 코드 기본값 사용

# ── API 키 (필수 · 실제 값은 .env 에만) ──────────────────────────
# OpenAI - 파싱·해석·임베딩 공통
OPENAI_API_KEY=sk-xxxxxxxxxxxxxxxxxxxxxxxx
# HIRA 공공데이터 (F-006 병원검색) - data.go.kr 발급
HIRA_API_KEY=your-hira-api-key-here

# ── 모델 ────────────────────────────────────────────────────────
PARSE_MODEL=gpt-4o-mini
INTERPRET_MODEL=gpt-4o-mini
EMBED_MODEL=text-embedding-3-small

# ── PDF 렌더링 해상도 (dpi) ──────────────────────────────────────
RENDER_DPI=150

# ── PostgreSQL / pgvector ───────────────────────────────────────
# 로컬은 docker compose 의 db (호스트에서 localhost:5433, 컨테이너 내부는 host=db)
DB_HOST=localhost
DB_PORT=5432
DB_NAME=gogodoc
DB_USER=gogodoc
DB_PASSWORD=gogodoc
DATABASE_URL=postgresql://gogodoc:gogodoc@localhost:5433/gogodoc

# ── 근거 검색 (retriever) ───────────────────────────────────────
# dict     : 동의어 사전 정확매칭 (DB 불필요 · 가장 안전)
# pgvector : 벡터 단독 (정규화 후엔 dict보다 약함 · 비권장)
# hybrid   : dict 우선 + 벡터 폴백 (권장) - DB + 색인 필요
#   전제: docker compose up -d db && python -m scripts.index_reference
#   DB 를 안 띄웠으면 RETRIEVER=dict 로 두세요 (hybrid 는 dict-miss 마다 연결 시도)
RETRIEVER=hybrid
# 벡터 코사인 거리 임계값 - 초과 시 미수록(OOV) 차단. 실측 캘리브레이션(0.45→0.55)
RETRIEVER_THRESHOLD=0.55
# 하이브리드 폴백 전용 임계값 - dict-miss 정밀도 우선(오구제 차단). 본 임계값보다 보수적
HYBRID_FALLBACK_THRESHOLD=0.50
