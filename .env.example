# OpenAI API 키 - 실제 키는 .env 에 저장하고 커밋 금지
OPENAI_API_KEY=sk-xxxxxxxxxxxxxxxxxxxxxxxx

# 모델 - 파싱/해석 모두 gpt-4o-mini 사용
PARSE_MODEL=gpt-4o-mini
INTERPRET_MODEL=gpt-4o-mini

# PDF 렌더링 해상도 (dpi)
RENDER_DPI=150

# PostgreSQL 접속 정보
DB_HOST=localhost
DB_PORT=5432
DB_NAME=gogodoc
DB_USER=postgres
DB_PASSWORD=
# 근거 검색 - dict(기본) | pgvector
RETRIEVER=dict
# pgvector 사용 시 (로컬은 localhost:5433, docker compose 는 host=db)
DATABASE_URL=postgresql://gogodoc:gogodoc@localhost:5433/gogodoc
EMBED_MODEL=text-embedding-3-small
# 벡터 코사인 거리 임계값 - 초과 시 미수록(OOV) 처리. 골든셋 실측으로 튜닝
RETRIEVER_THRESHOLD=0.45

# HIRA 공공데이터 API 키 (data.go.kr 발급)
HIRA_API_KEY=your-hira-api-key-here
