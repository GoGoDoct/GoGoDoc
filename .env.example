# OpenAI API 키 - 실제 키는 .env 에 저장하고 커밋 금지
OPENAI_API_KEY=sk-xxxxxxxxxxxxxxxxxxxxxxxx

# 모델 - 파싱/해석 모두 gpt-4o-mini 사용
PARSE_MODEL=gpt-4o-mini
INTERPRET_MODEL=gpt-4o-mini

# PDF 렌더링 해상도 (dpi)
RENDER_DPI=150

# PostgreSQL 접속 정보
DB_HOST=localhost
DB_PORT=5432
DB_NAME=gogodoc
DB_USER=postgres
DB_PASSWORD=
